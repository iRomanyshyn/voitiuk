---
layout: null
lang: uk
permalink: /uk/publications/feed.xml
alternate_en: /en/publications/feed.xml
alternate_uk: /uk/publications/feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Публікації — Анна Войтюк</title>
    <description>Статті, дослідження та публікації про творчість української художниці-графіка Анни Войтюк.</description>
    <link>{{ '/uk/publications/' | absolute_url }}</link>
    <atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml" />
    <language>uk</language>
    {% assign newest_item = site.data.articles | sort: 'date' | last %}
    {% if newest_item %}<lastBuildDate>{{ newest_item.date_modified | default: newest_item.date | date_to_rfc822 }}</lastBuildDate>{% endif %}
    {% assign feed_items = site.data.articles | sort: 'date' | reverse %}
    {% for item in feed_items %}
    <item>
      <title>{{ item.title.uk | xml_escape }}</title>
      <link>{{ item.url.uk | absolute_url }}</link>
      <guid isPermaLink="true">{{ item.url.uk | absolute_url }}</guid>
      <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
      <description>{{ item.summary.uk | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
